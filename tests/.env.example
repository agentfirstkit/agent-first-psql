# Local macOS integration tests create an isolated, disposable PostgreSQL with
# Apple container automatically. Set this only to test against an explicit
# external database instead.
# A local DSN targeting localhost/127.0.0.1/[::1] port 5432 is rejected so the
# fixed test gate cannot accidentally use the workstation's primary database.
# AFPSQL_TEST_DSN_SECRET=postgresql://test:test@127.0.0.1:55432/test?sslmode=disable

# Optional image overrides used by `scripts/test.sh container` and the temporary
# integration database. Local macOS uses Apple container; CI uses Docker.
# AFPSQL_E2E_POSTGRES_IMAGE=postgres:16
# AFPSQL_E2E_BRIDGE_IMAGE=ubuntu:22.04
